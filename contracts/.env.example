# Copy to .env and fill in. .env is gitignored.
#
# Use a throwaway key. A testnet deploy has no reason to touch a wallet that holds
# anything on mainnet, and mainnet should use a separate key you control directly.
PRIVATE_KEY=
DEPLOYER_ADDRESS=

ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Blockscout does not check this, but forge requires it to be non-empty.
BLOCKSCOUT_API_KEY=blockscout
