# Chain. 4663 is Robinhood Chain mainnet, 46630 is its testnet. Defaults to 4663.
NEXT_PUBLIC_CHAIN_ID=4663
# Optional. viem's built-in endpoint is public and rate limited.
NEXT_PUBLIC_RPC_URL=

# Absolute origin. Every share link and OG image URL is built from it.
#
# Set this on any deployment with a custom domain. Unset, it falls back to Vercel's
# VERCEL_PROJECT_PRODUCTION_URL (the production domain) and then to VERCEL_URL (the unique
# per-deployment URL), and the second of those is what hands a visitor on your own domain a
# share link to project-a1b2c3-team.vercel.app.
NEXT_PUBLIC_APP_URL=https://www.sealdrop.family

# "mock" or "chain". The one switch that turns part 1 into part 2. Defaults to mock.
NEXT_PUBLIC_LOCKS_ADAPTER=mock
# Airdrops have their own switch: the two contracts can go live on different days.
NEXT_PUBLIC_AIRDROPS_ADAPTER=mock
# Set once part 2 deploys the lock contract.
NEXT_PUBLIC_LOCKER_ADDRESS=

# Optional. Without it the wallet list drops the QR-based options and keeps EIP-6963
# extension discovery, which is enough for desktop.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
